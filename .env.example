# Variables de entorno requeridas / opcionales para Facturación OCR
# Copia este archivo como .env y ajusta los valores.

# --- Base de datos ---
# Para desarrollo local, SQLite se usa por defecto (sin configurar esto).
# Para producción, usa PostgreSQL (Neon, etc.):
DATABASE_URL=postgresql://user:password@host:5432/facturacion

# --- Seguridad ---
# OBLIGATORIO en producción. Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-este-valor-en-produccion

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Monitoreo (opcional) ---
SENTRY_DSN=
