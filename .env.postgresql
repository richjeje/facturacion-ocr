# Configuración PostgreSQL para Producción
# Copiar a .env para usar PostgreSQL

# Base de Datos PostgreSQL (Producción)
DATABASE_URL=postgresql://facturacion_user:micontraseña@localhost:5432/facturacion_ocr
DB_SCHEMA=public

# Base de Datos SQLite (Desarrollo - default)
# DATABASE_URL=sqlite:///./facturacion_ocr.db

# Instrucciones para migrar a PostgreSQL:

# 1. Crear contenedor PostgreSQL:
docker run -d --name postgres-facturacion \
  -e POSTGRES_PASSWORD=micontraseña \
  -e POSTGRES_USER=facturacion_user \
  -e POSTGRES_DB=facturacion_ocr \
  -p 5432:5432 \
  -v postgres_data:/var/lib/postgresql/data \
  postgres:15

# 2. Esperar a que inicie (30 segundos)
# 3. Ejecutar migración:
python add_cfdi_tables.py

# 4. Iniciar aplicación con PostgreSQL:
# Las variables DATABASE_URL y DB_SCHEMA se configuran automáticamente

# Notas:
# - SQLite sigue siendo el default si DATABASE_URL no está configurado
# - Todos los modelos son compatibles con ambas BD
# - Las migraciones son idempotentes (se pueden ejecutar varias veces)
# - Para volver a SQLite: comenta DATABASE_URL y usa el default